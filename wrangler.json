{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hotdog-clicker",
  "compatibility_date": "2025-04-01",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "first_party_worker": true,
  "assets": {
    "directory": "./site",
    "not_found_handling": "none"
  },
  "build": {
    "command": "bash ./build-guard.sh",
    "watch_dir": [
      "./site/ts",
      "./site/index.css",
      "./site/index.max.html",
      "./site/assets",
      "./worker/index.ts",
      "./shared",
      "./tsconfig.json",
      "./worker/tsconfig.json",
      "./wrangler.json",
      "./build.sh",
      "./build-guard.sh"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hotdog-clicker-db",
      "database_id": "323937b2-8bb1-4f6d-a7cd-fc1a9146acb1"
    }
  ]
}
